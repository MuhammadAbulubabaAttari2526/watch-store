# Custom backend API origin.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Digits only, with country code, e.g. 923001234567. Leave empty to hide WhatsApp links.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Public address of the storefront (used in sitemap and canonical URLs). Change when you deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Testing on your phone (same Wi-Fi): set NEXT_PUBLIC_SITE_URL to your PC's address and run npm run dev -- -H 0.0.0.0.
